files:
  "/etc/systemd/system/reverb.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Laravel Reverb WebSocket Server
      After=network.target

      [Service]
      Type=simple
      User=webapp
      WorkingDirectory=/var/app/current
      ExecStart=/usr/bin/php /var/app/current/artisan reverb:start --host=127.0.0.1 --port=8080
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

container_commands:
  01_reload_systemd:
    command: "systemctl daemon-reload"
  02_enable_reverb:
    command: "systemctl enable reverb.service"
  03_restart_reverb:
    command: "systemctl restart reverb.service"